# {{ ansible_managed }}
[Service]
ExecStart=
ExecStart={{ ingress_caddy_binary }} run --environ --config {{ ingress_config_path }}
ExecReload=
ExecReload={{ ingress_caddy_binary }} reload --config {{ ingress_config_path }} --address unix/{{ ingress_admin_socket }} --force
RuntimeDirectory={{ ingress_admin_socket | dirname | basename }}
RuntimeDirectoryMode=0750
UMask=0007
